# Server
SERVER_PORT=8080
SERVER_HOST=0.0.0.0
ENVIRONMENT=production

# Database
DATABASE_URL=postgres://user:pass@localhost:5432/security_auditor
REDIS_URL=redis://localhost:6379

# Git
GIT_TEMP_DIR=/tmp/scans
GIT_CLONE_TIMEOUT=5m
MAX_REPO_SIZE_MB=500

# ADK
ADK_PROJECT_ID=your-project-id
ADK_LOCATION=us-central1
ADK_MODEL=gemini-2.0-flash-exp
ADK_API_KEY=your-api-key

# GitHub
GITHUB_APP_ID=123456
GITHUB_INSTALLATION_ID=789012
GITHUB_PRIVATE_KEY_PATH=/secrets/github.pem
GITHUB_WEBHOOK_SECRET=your-webhook-secret

# Security
API_KEY=your-api-key
JWT_SECRET=your-jwt-secret

# Logging
LOG_LEVEL=info
LOG_FORMAT=json
