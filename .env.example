# Bastion API server environment.
# The CLI and the MCP server need none of this — they run with no configuration.
#
# Viper reads CSA_-prefixed variables (CSA_<SECTION>_<KEY>); a few database keys
# also accept their POSTGRES_ equivalents.

APP_ENV=development

# Server
CSA_SERVER_HOST=0.0.0.0
CSA_SERVER_PORT=8080
CSA_SERVER_API_KEY=replace-with-a-long-random-api-key

# Database
CSA_DATABASE_HOST=localhost
CSA_DATABASE_PORT=5432
CSA_DATABASE_USER=postgres
CSA_DATABASE_PASSWORD=replace-with-a-database-password
CSA_DATABASE_DBNAME=code_security_auditor

# Logging
CSA_LOGGING_LEVEL=info
CSA_LOGGING_FORMAT=json
